        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(pg_up, namespace)",
          "refId": "namespace-var"
        },
        "definition": "label_values(pg_up, namespace)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "regex": "",
