          "refId": "datname-var"
        },
        "definition": "label_values(pg_database_size_bytes{namespace=\"$namespace\"}, datname)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "regex": "",
